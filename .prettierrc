{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "es5",

  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "^(components|contexts|hooks|images|util)\/", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
